# --- required ---------------------------------------------------------------
# Postgres. This default matches docker-compose.yml (`docker compose up -d`).
DATABASE_URL="postgresql://coffee:coffee@localhost:5440/coffee"

# Session signing key. Generate a real one with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Optional: "Continue with Google" on the login page (leave empty to hide the button)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- payments ---------------------------------------------------------------
# Signs the payment callback (HMAC-SHA256), so nobody can fake a "paid" notice.
# A fixed development value is used locally when this is empty; production requires it.
PAYMENT_CALLBACK_SECRET=""

# Protects the scheduled jobs (/api/cron/*). Vercel Cron sends it as a bearer token.
CRON_SECRET=""

# --- optional services: the app runs without any of them ---------------------
# Email (Resend). Without a key every email is saved in the dashboard's Emails page only.
RESEND_API_KEY=""
EMAIL_FROM="Ember Roastery <onboarding@resend.dev>"
# Rate limiting (Upstash Redis). Without it an in-memory limiter is used (single instance only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Product image uploads (Cloudinary). Without it, images are pasted as URLs.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Error tracking (Sentry)
SENTRY_DSN=""
# Public origin, used in emails and sitemap
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- automated tests only (never in production) -------------------------------
# e2e logs in dozens of times a minute.
# RATE_LIMIT_DISABLED=true
