generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Money is always an Int in qirsh (1 EGP = 100), never a Float.
// Text shown to customers in two languages is stored as Json `{ "en": "...", "ar": "..." }`
// (type LocalizedText in src/lib/i18n/localized.ts, validated with Zod at the edges).

enum Role {
  CUSTOMER
  ADMIN
  VIEWER
}

enum Locale {
  en
  ar
}

// Order lifecycle. Payment has its own status: a cash-on-delivery order is CONFIRMED but UNPAID.
enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  COD
}

enum RoastLevel {
  LIGHT
  MEDIUM
  DARK
}

enum InventoryReason {
  SALE
  CANCELLATION
  MANUAL_ADJUSTMENT
  RESTOCK
}

enum EventType {
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_START
  ORDER_PLACED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  phone         String? // 01xxxxxxxxx
  image         String?
  role          Role      @default(CUSTOMER)
  locale        Locale    @default(ar) // language of emails and invoices
  orders        Order[]
  addresses     Address[]
  cart          Cart?
  tokens        AuthToken[]
  sessions      Session[]
  accounts      Account[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([role, createdAt])
}

/// Better Auth: one row per signed-in browser. The cookie holds `token`.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Better Auth: how a user signs in. Email + password is providerId "credential" with the bcrypt hash in `password`.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

/// Better Auth's own one-time values (unused by email + password; kept because its adapter expects the model).
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// One-time links sent by email (verify the address, reset the password). Only the hash is stored.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "verify" | "reset"
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model ShippingZone {
  id           String    @id @default(cuid())
  name         Json // LocalizedText: "Greater Cairo" / "القاهرة الكبرى"
  governorates String[] // governorate codes: ["CAI", "GIZ", "QLY"]
  feeCents     Int
  etaDays      Int
  sortOrder    Int       @default(0)
  addresses    Address[]
}

model Address {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  governorate String // one of the 27 codes (src/lib/geo)
  zoneId      String
  zone        ShippingZone @relation(fields: [zoneId], references: [id])
  area        String
  street      String
  building    String
  notes       String?
  isDefault   Boolean      @default(false)

  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  name      Json // LocalizedText
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id           String           @id @default(cuid())
  name         Json // LocalizedText
  slug         String           @unique
  description  Json // LocalizedText
  searchText   String // both names + descriptions, lower-cased: what pg_trgm searches
  origin       String?
  roastLevel   RoastLevel?
  tastingNotes String[] // translation keys: ["chocolate", "berry"]
  images       String[]
  categoryId   String
  category     Category         @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([categoryId, isActive])
}

model ProductVariant {
  id                String         @id @default(cuid())
  productId         String
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  name              Json // LocalizedText: "250g - Espresso"
  sku               String         @unique
  priceCents        Int // includes VAT
  stock             Int            @default(0)
  lowStockThreshold Int            @default(5)
  isArchived        Boolean        @default(false) // variants are archived, never deleted
  cartItems         CartItem[]
  orderItems        OrderItem[]
  inventoryLogs     InventoryLog[]
  subscribers       Subscriber[]

  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([cartId, variantId])
}

model Order {
  id               String         @id @default(cuid())
  orderNumber      Int            @unique @default(autoincrement())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  status           OrderStatus    @default(PENDING)
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus  @default(UNPAID)
  paymentRef       String?        @unique
  paymentExpiresAt DateTime?
  subtotalCents    Int
  shippingCents    Int
  vatCents         Int // the VAT included in the total, kept as a snapshot
  totalCents       Int
  shippingAddress  Json // snapshot at order time
  locale           Locale         @default(ar) // customer's language at order time
  confirmedAt      DateTime? // when the order became real: the date every report uses
  items            OrderItem[]
  events           OrderEvent[]
  inventoryLogs    InventoryLog[]
  emails           EmailLog[]
  createdAt        DateTime       @default(now())

  @@index([status, confirmedAt])
  @@index([confirmedAt])
  @@index([userId, createdAt])
  @@index([paymentStatus, paymentExpiresAt])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  productName    Json // snapshot at order time, both languages
  variantName    Json
  unitPriceCents Int // snapshot at order time
  quantity       Int

  @@index([orderId])
  @@index([variantId])
}

model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String // "created" | "status_changed" | "payment_succeeded" | "payment_failed" | "refunded" | "expired"
  fromStatus String?
  toStatus   String?
  actorId    String? // null = the system
  note       String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([createdAt])
}

model InventoryLog {
  id        String          @id @default(cuid())
  variantId String
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change    Int
  reason    InventoryReason
  orderId   String?
  order     Order?          @relation(fields: [orderId], references: [id])
  actorId   String?
  note      String?
  createdAt DateTime        @default(now())

  @@index([variantId, createdAt])
}

model Subscriber {
  id         String          @id @default(cuid())
  email      String
  source     String // "newsletter" | "subscription-interest" | "back-in-stock"
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locale     Locale          @default(ar)
  notifiedAt DateTime?
  createdAt  DateTime        @default(now())

  // Postgres treats NULLs as distinct, so the service also checks "same email + source, no variant"
  @@unique([email, source, variantId])
}

model AnalyticsEvent {
  id        String    @id @default(cuid())
  type      EventType
  sessionId String // anonymous id from a cookie
  userId    String?
  productId String?
  orderId   String?
  createdAt DateTime  @default(now())

  @@index([type, createdAt])
  @@index([sessionId])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  type      String // "verify" | "reset" | "order_confirmed" | "shipped" | "apology" | "back_in_stock"
  status    String // "sent" | "failed" | "logged_only"
  html      String
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Admin edits that have no history table of their own (product details and prices, shipping zones).
/// Order changes live in OrderEvent and stock changes in InventoryLog; the activity page reads all three.
model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String? // null = the system
  action    String // "product_created" | "product_updated" | "product_archived" | "price_changed" | "shipping_zone_updated" ...
  entity    String // "product" | "shipping_zone"
  entityId  String
  label     String // what the entity was called at the time ("Ethiopia Yirgacheffe"), so the feed survives renames
  details   Json? // small structured payload for display: { from: 36000, to: 38000 }
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}
